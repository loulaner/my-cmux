// Dedicated device-only direct build. No changes to ordinary Debug or personal Release.
#include "Debug.xcconfig"
CMUX_APP_BUNDLE_IDENTIFIER = com.loulaner.mycmux.ios.debug.local-terminal-device
CMUX_HOST_BUNDLE_IDENTIFIER = $(CMUX_APP_BUNDLE_IDENTIFIER)
PRODUCT_BUNDLE_IDENTIFIER = $(CMUX_APP_BUNDLE_IDENTIFIER)
PRODUCT_NAME = MyCMUX Direct DEV
PRODUCT_MODULE_NAME = cmux_local_direct
PRODUCT_DISPLAY_NAME = MyCMUX Direct DEV
CMUX_DEV_TAG = local-terminal-device
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Automatic
CMUX_APP_CODE_SIGN_ENTITLEMENTS = Config/cmux-local-direct.entitlements
CODE_SIGN_ENTITLEMENTS = $(CMUX_APP_CODE_SIGN_ENTITLEMENTS)
CMUX_IOS_URL_SCHEME =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/LocalDirectInfo.plist
INFOPLIST_KEY_NSCameraUsageDescription =
