    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your Mac over Tailscale for direct terminal access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 経由で Mac に接続し、ターミナルに直接アクセスします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Tailscale mit deinem Mac verbinden, um direkt auf das Terminal zuzugreifen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à votre Mac via Tailscale pour accéder directement au terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a tu Mac mediante Tailscale para acceder directamente al terminal."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بجهاز Mac عبر Tailscale للوصول المباشر إلى الطرفية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Tailscale 连接 Mac，直接访问终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Tailscale 連接 Mac，直接存取終端機。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale을 통해 Mac에 연결하여 터미널에 직접 접근합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
